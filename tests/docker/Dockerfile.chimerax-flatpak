# ChimeraX from Flathub (published by UCSF) inside a Linux container, headless with offscreen rendering.
# Build:  docker build -f tests/docker/Dockerfile.chimerax-flatpak -t molmcp-chimerax-flatpak .
# Run:    docker run --rm --privileged molmcp-chimerax-flatpak        (privileged: flatpak's bubblewrap sandbox)
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends flatpak ca-certificates python3 python3-venv python3-pip && rm -rf /var/lib/apt/lists/*
RUN flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
 && flatpak install -y --noninteractive flathub edu.ucsf.rbvi.ChimeraX
# expose ChimeraX as a normal executable; the bridge's state dir and the repo are shared into the sandbox
RUN printf '#!/bin/sh\nexec flatpak run --filesystem=host --share=network --env=MOLMCP_HOME="${MOLMCP_HOME:-$HOME/.molmcp}" --env=MOLMCP_CHIMERAX_AUTOSTART="${MOLMCP_CHIMERAX_AUTOSTART:-1}" edu.ucsf.rbvi.ChimeraX "$@"\n' > /usr/local/bin/chimerax && chmod +x /usr/local/bin/chimerax
WORKDIR /work
COPY . /work/mol-mcp
RUN cd /work/mol-mcp && rm -rf .venv && python3 -m venv .venv && .venv/bin/pip install -q -e .
ENV HOME=/root MOLMCP_HOME=/root/.molmcp
CMD ["bash", "/work/mol-mcp/tests/docker/linux_smoke_chimerax.sh"]
