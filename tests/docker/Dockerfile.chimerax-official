# Linux smoke test for ChimeraX headless (--nogui --offscreen) + molmcp, based on UCSF's official
# headless image (docker.io/ucsfrbvi/chimerax, multi-arch).  No license click-through needed.
#   docker build -f tests/docker/Dockerfile.chimerax-official -t molmcp-chimerax-official .
#   docker run --rm molmcp-chimerax-official
FROM ucsfrbvi/chimerax:latest
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash tester
# ChimeraX refuses a real user data directory for root, so run as a normal user
USER tester
WORKDIR /home/tester/work
COPY --chown=tester:tester . /home/tester/work/mol-mcp
RUN cd /home/tester/work/mol-mcp && rm -rf .venv && python3 -m venv .venv && .venv/bin/pip install -q -e .
ENV HOME=/home/tester MOLMCP_HOME=/home/tester/.molmcp
ENTRYPOINT []
CMD ["bash", "/home/tester/work/mol-mcp/tests/docker/linux_smoke_chimerax.sh"]
