# Linux smoke test for ChimeraX headless (--nogui --offscreen) + molmcp.
# ChimeraX must be downloaded by you (license acceptance): put the Ubuntu 24.04 .deb for your CPU
# architecture at tests/docker/chimerax.deb, then:
#   docker build -f tests/docker/Dockerfile.chimerax-linux -t molmcp-chimerax-linux .
#   docker run --rm molmcp-chimerax-linux
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates libosmesa6 libgl1 libegl1 libxkbcommon0 libdbus-1-3 libfontconfig1 libglib2.0-0 xz-utils && rm -rf /var/lib/apt/lists/*
COPY tests/docker/chimerax.deb /tmp/chimerax.deb
RUN apt-get update && apt-get install -y --no-install-recommends /tmp/chimerax.deb && rm -rf /var/lib/apt/lists/* /tmp/chimerax.deb
WORKDIR /work
COPY . /work/mol-mcp
RUN cd /work/mol-mcp && rm -rf .venv && python3 -m venv .venv && .venv/bin/pip install -q -e .
ENV HOME=/root MOLMCP_HOME=/root/.molmcp QT_QPA_PLATFORM=offscreen
CMD ["bash", "/work/mol-mcp/tests/docker/linux_smoke_chimerax.sh"]
